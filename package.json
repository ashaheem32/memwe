{
  "name": "memwe",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "up": "docker compose up -d && pnpm wait && pnpm migrate",
    "down": "docker compose down",
    "nuke": "docker compose down -v",
    "wait": "node scripts/wait-for-pg.mjs",
    "migrate": "pnpm --filter @memwe/db migrate",
    "seed": "pnpm --filter @memwe/db seed",
    "dev:worker": "pnpm --filter @memwe/worker dev",
    "dev:api": "pnpm --filter @memwe/api dev",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "verify": "pnpm lint && pnpm typecheck && pnpm migrate && pnpm seed && pnpm test"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@biomejs/biome": "^2.5.10",
    "@memwe/contracts": "workspace:*",
    "@memwe/db": "workspace:*",
    "@memwe/storage": "workspace:*",
    "@types/node": "^22.10.2",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
