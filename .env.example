# ---- local stack (docker compose) ----
# owner — migrations + worker (bypasses RLS)
DATABASE_URL=postgres://memwe:memwe@localhost:5432/memwe
# app role — every request-scoped read (RLS enforced)
APP_DATABASE_URL=postgres://memwe_app:memwe_app@localhost:5432/memwe
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=memwe-blobs
S3_ACCESS_KEY=memwe
S3_SECRET_KEY=memwedevsecret
S3_REGION=us-east-1

# ---- api ----
PORT=8080
LOG_LEVEL=debug

# ---- worker ----
WORKER_CONCURRENCY=4
WORKER_POLL_MS=500
WORKER_HEARTBEAT_MS=5000
JOB_MAX_ATTEMPTS=5

# ---- extraction ----
# OCR runs locally (tesseract.js) so it needs no model API key. It downloads
# ~15MB of language data on first use and caches it.
OCR_ENABLED=true
PDF_MAX_PAGES=500
PDF_OCR_MIN_CHARS=16     # a page with fewer real chars is treated as an image
PDF_OCR_MAX_PAGES=20     # per document; skipped pages are logged, never silent
PDF_OCR_DPI=200

# ---- url ingestion ----
# auto | http | headless. `auto` fetches over plain HTTP and renders in a
# headless Chromium only when the page is a JavaScript shell; `headless`
# always renders; `http` never does. The browser needs a one-time
# `pnpm --filter @memwe/worker exec playwright install chromium`.
URL_FETCH_MODE=auto
URL_FETCH_TIMEOUT_MS=20000
URL_MAX_BYTES=20971520     # 20 MB, applied while the body streams
URL_MAX_REDIRECTS=5
# Private, loopback, link-local and metadata addresses are refused at the
# API and again in the worker, on every hop and every in-page request.
# Only ever set this for local development against your own services.
URL_ALLOW_PRIVATE=false
# URL_USER_AGENT=Mozilla/5.0 (compatible; memwe/0.1)
# URL_BROWSER_CHANNEL=chrome  # use an installed Chrome instead of Playwright's Chromium

# ---- chunking ----
# Token counts come from o200k, a stand-in until the embedding model is
# chosen. A chars/4 heuristic was measured and rejected: -72% on emoji,
# -38% on code — exactly where a hard model limit gets exceeded.
CHUNK_TARGET_TOKENS=600
CHUNK_MAX_TOKENS=810     # ceiling; a block larger than this is split
CHUNK_MIN_TOKENS=120     # below this a heading boundary is not worth honouring
CHUNK_OVERLAP=0.12       # fraction of target carried across a budget split

# ---- embeddings ----
# auto | voyage | openai | hash.  `auto` picks a hosted provider only when
# its key is present — no ingest job starts spending money by default.
EMBED_PROVIDER=auto
# VOYAGE_API_KEY=
# OPENAI_API_KEY=
# EMBED_MODEL=voyage-3-large
# EMBED_URL=https://api.openai.com/v1/embeddings
# Without a key the pipeline falls back to a deterministic, NON-SEMANTIC
# stand-in stamped `hash-v1`. Fine for tests; refused in production unless
# you set this deliberately.
# EMBED_ALLOW_HASH=false
EMBED_MAX_ATTEMPTS=4
EMBED_WRITE_BATCH=200

# ---- contextual chunk headers ----
# One model request per document: the whole document goes in as a cached
# prefix, every chunk that needs context follows, and the contexts come back
# in one structured response. auto | anthropic | none. `auto` only selects
# the model when ANTHROPIC_API_KEY is set; without it chunks carry the
# heading path alone and nothing is billed.
CONTEXT_PROVIDER=auto
CONTEXT_MODEL=claude-opus-5
CONTEXT_EFFORT=low            # low | medium | high | xhigh | max
CONTEXT_CHUNKS_PER_PASS=60    # more chunks than this = more passes sharing the cached prefix
CONTEXT_MAX_OUTPUT_TOKENS=16000
CONTEXT_MAX_CHARS=600         # a longer context is cut, and logged
CONTEXT_MAX_DOC_TOKENS=200000 # above this the document keeps heading paths only, recorded on the row

# ---- models ----
ANTHROPIC_API_KEY=
# Hard ceiling. Set this BEFORE the first context job ever runs — it is a
# placeholder, not an enforcement mechanism; set the real cap in the console.
MODEL_MONTHLY_BUDGET_USD=50
